{
  "name": "openvideo",
  "version": "0.1.0",
  "description": "Douyin-first short video analysis and HyperFrames generation toolkit.",
  "type": "module",
  "bin": {
    "openvideo": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
